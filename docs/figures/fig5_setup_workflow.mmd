  F --> G["TA: create 5 closed streams,<br/>issue CREDIT (open asset)"]
  G --> H["all nodes subscribe;<br/>TA grants RSUs verdicts.write"]
  H --> I["per vehicle: getnewaddress on RSU,<br/>TA grants send,receive,reports.write,<br/>publishes registry + trust (TV0 = 1)"]
